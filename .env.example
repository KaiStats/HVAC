# --- Supabase ---
# Project URL and anon key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key is SERVER ONLY. Never expose to the client.
# Used for the ingestion pipeline (writing chunks after parsing/embedding).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# Haiku for high-volume Q&A.
ANTHROPIC_QA_MODEL=claude-3-5-haiku-latest

# --- Voyage AI (embeddings) ---
VOYAGE_API_KEY=pa-...
# voyage-3.5-lite returns 1024-dim vectors (matches the DB schema).
VOYAGE_EMBED_MODEL=voyage-3.5-lite
