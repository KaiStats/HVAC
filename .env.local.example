# Copy this file to .env.local and fill in your values.

# REQUIRED: Anthropic API Key for Claude-powered chatbot
# Get from https://console.anthropic.com/
# This is read server-side only and is never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-v0-...

# OPTIONAL: Supabase for persistent booking storage
# Once integrated, bookings will be saved to demo_leads table
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# OPTIONAL: Twilio for SMS notifications
# When ready, SMS will be sent to customers on booking confirmation
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+17025550147
